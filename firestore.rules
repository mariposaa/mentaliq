rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Is user signed in?
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper: Is document owner?
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users and their private data
    match /users/{userId} {
      allow read, write: if isSignedIn() && isOwner(userId);
      
      match /user_data/{document=**} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }
      
      match /goals/{goalId} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }
      
      match /partners/{partnerId} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }
      
      match /chats/{chatId} {
        allow read, write: if isSignedIn() && isOwner(userId);
        
        match /messages/{messageId} {
          allow read, write: if isSignedIn() && isOwner(userId);
        }
      }
      
      match /style_closet/{itemId} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }
      match /notifications/{notificationId} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }
    }

    // Kullanıcı DNA (Natal Chart dahil)
    match /user_dna/{userId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    // Astroloji Günlük Yönergeler
    match /astro_guidance/{userId}/{document=**} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    // Astroloji ve Kozmik HUD Sonuçları (eski sistem)
    match /astro_results/{userId}/{document=**} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }
    
    // Rüya Tabiri Sonuçları
    match /dream_results/{userId}/{document=**} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    // Burç Yorumları Raporları (Global Erişim/Cache)
    match /horoscope_reports/{document=**} {
      allow read, write: if isSignedIn();
    }

    // Kamp Ateşi - Forum
    match /forum_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // Yazar tam güncelleme/silme yapabilir; diğer kullanıcılar çeviri, destek ve yorum sayısı güncelleyebilir
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid || 
        request.resource.data.authorId == request.auth.uid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['translations'])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supportedBy', 'supportCount'])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']))
      );
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || request.resource.data.authorId == request.auth.uid);
      }
    }
    match /forum_daily_questions/{qId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
