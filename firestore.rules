rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Is user signed in?
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper: Is document owner?
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users and their private data
    match /users/{userId} {
      allow read, write: if isSignedIn() && isOwner(userId);
      
      match /user_data/{document=**} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }
      
      match /goals/{goalId} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }
      
      match /partners/{partnerId} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }
      
      match /chats/{chatId} {
        allow read, write: if isSignedIn() && isOwner(userId);
        
        match /messages/{messageId} {
          allow read, write: if isSignedIn() && isOwner(userId);
        }
      }
      
      match /style_closet/{itemId} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }
    }

    // Astroloji ve Kozmik HUD Sonuçları
    match /astro_results/{userId}/{document=**} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }
    
    // Rüya Tabiri Sonuçları
    match /dream_results/{userId}/{document=**} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    // Burç Yorumları Raporları (Global Erişim/Cache)
    match /horoscope_reports/{document=**} {
      allow read, write: if isSignedIn();
    }

    // ==================== CAMPFIRE KURALLARI ====================
    
    // Helper: Kullanıcı bu cohort'un üyesi mi? (mevcut doküman için)
    function isCohortMember(cohortId) {
      return isSignedIn() && 
             request.auth.uid in resource.data.members;
    }
    
    // Helper: Parent cohort'un üyesi mi? (create işlemleri için)
    function isParentCohortMember(cohortId) {
      return isSignedIn() && 
             request.auth.uid in get(/databases/$(database)/documents/campfire_cohorts/$(cohortId)).data.members;
    }
    
    // Helper: Yeni cohort oluştururken kullanıcı kendisini members'a ekliyor mu?
    function isCreatingOwnCohort() {
      return isSignedIn() && 
             request.auth.uid in request.resource.data.members;
    }
    
    match /campfire_cohorts/{cohortId} {
      // Cohort okuma: Sadece üyeler
      allow read: if isCohortMember(cohortId);
      
      // Cohort oluşturma: Kullanıcı kendisini members'a eklemeli
      allow create: if isCreatingOwnCohort();
      
      // Cohort güncelleme: Sadece üyeler
      allow update: if isCohortMember(cohortId);
      
      // Cohort silme: Sadece Cloud Functions (kullanıcılar silemez)
      allow delete: if false;
      
      match /lobby_interactions/{interactionId} {
        // Lobby etkileşimleri okuma: Cohort üyeleri
        allow read: if isCohortMember(cohortId);
        // Lobby etkileşimleri oluşturma: Parent cohort üyesi olmalı
        allow create: if isParentCohortMember(cohortId);
        allow update, delete: if false;
      }
      
      match /sessions/{sessionId} {
        // Session okuma/güncelleme: Cohort üyeleri
        allow read, update: if isCohortMember(cohortId);
        // Session oluşturma: Parent cohort üyesi olmalı (Cloud Functions da oluşturabilir)
        allow create: if isParentCohortMember(cohortId);
        allow delete: if false;
        
        match /messages/{messageId} {
          // Mesaj okuma: Cohort üyeleri
          allow read: if isCohortMember(cohortId);
          // Mesaj gönderme: Parent cohort üyesi olmalı
          allow create: if isParentCohortMember(cohortId);
          // Mesajlar immutable (güncelleme/silme yok)
          allow update, delete: if false;
        }
      }
    }
  }
}
