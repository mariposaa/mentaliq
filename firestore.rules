rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Is user signed in?
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper: Is document owner?
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Helper: Is current user admin?
    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/admin_emails/$(request.auth.token.email));
    }

    function isOwnerAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'mariposa.u78@gmail.com';
    }

    function canManageDailyQuestions() {
      return isAdmin();
    }

    // Users and their private data
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create, update, delete: if isSignedIn() && (isOwner(userId) || isAdmin());
      
      match /user_data/{document=**} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }
      
      match /goals/{goalId} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }
      
      match /partners/{partnerId} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }
      
      match /chats/{chatId} {
        allow read, write: if isSignedIn() && isOwner(userId);
        
        match /messages/{messageId} {
          allow read, write: if isSignedIn() && isOwner(userId);
        }
      }
      
      match /style_closet/{itemId} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }
      match /style_outfit_history/{recordId} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }
      match /notifications/{notificationId} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }
      match /fcm_tokens/{tokenId} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }
    }

    // Admin e-mail whitelist
    match /admin_emails/{email} {
      allow read: if isSignedIn() && (request.auth.token.email == email || isAdmin());
      allow write: if isOwnerAdmin();
    }

    match /style_inspiration_pool/{itemId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isAdmin();
    }

    match /silent_flirt_profiles/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /silent_flirt_chats/{chatId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participants);
      allow create: if isSignedIn() &&
        (request.auth.uid in request.resource.data.participants);
      allow update: if isSignedIn() &&
        (request.auth.uid in resource.data.participants);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          (request.auth.uid in get(/databases/$(database)/documents/silent_flirt_chats/$(chatId)).data.participants);
        allow create: if isSignedIn() &&
          (request.auth.uid in get(/databases/$(database)/documents/silent_flirt_chats/$(chatId)).data.participants);
        allow update, delete: if false;
      }
    }

    match /silent_flirt_reports/{reportId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && isAdmin();
      allow update, delete: if false;
    }

    // Kullanıcı DNA (Natal Chart dahil)
    match /user_dna/{userId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    // Astroloji Günlük Yönergeler
    match /astro_guidance/{userId}/{document=**} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    // Astroloji ve Kozmik HUD Sonuçları (eski sistem)
    match /astro_results/{userId}/{document=**} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }
    
    // Rüya Tabiri Sonuçları
    match /dream_results/{userId}/{document=**} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    // Burç Yorumları Raporları (Global Erişim/Cache)
    match /horoscope_reports/{document=**} {
      allow read, write: if isSignedIn();
    }

    // Kamp Ateşi - Forum
    match /forum_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // Yazar tam güncelleme/silme yapabilir; diğer kullanıcılar çeviri, destek ve yorum sayısı güncelleyebilir
      allow update: if isSignedIn() && (
        isAdmin() ||
        resource.data.authorId == request.auth.uid || 
        request.resource.data.authorId == request.auth.uid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['translations'])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supportedBy', 'supportCount'])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']))
      );
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }
    match /forum_daily_questions/{qId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && canManageDailyQuestions();
    }
  }
}
